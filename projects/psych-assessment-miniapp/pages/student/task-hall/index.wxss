/* pages/student/task-hall/index.wxss */
.page {
  min-height: 100vh;
  background: #F3F4F6;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ========== 顶部栏 ========== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.join-capsule {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(99, 102, 241, 0.28);
  font-weight: 600;
  font-size: 28rpx;
}
.join-plus { font-size: 32rpx; margin-right: 8rpx; line-height: 1; }
.demo-badge {
  font-size: 22rpx;
  color: #B45309;
  background: #FEF3C7;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

/* ========== 加载 / 空态 ========== */
.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}
.spinner {
  width: 60rpx; height: 60rpx;
  border: 6rpx solid #E5E7EB;
  border-top-color: #6366F1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-tip { color: #6B7280; font-size: 26rpx; }

.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 32rpx; color: #1F2937; font-weight: 600; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #6B7280; text-align: center; line-height: 1.6; }

/* ========== 任务卡片 ========== */
.task-list { display: flex; flex-direction: column; gap: 24rpx; }
.task-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.task-header { margin-bottom: 16rpx; }
.task-title { font-size: 32rpx; font-weight: 700; color: #111827; line-height: 1.4; }
.task-class-name { font-size: 24rpx; color: #6B7280; margin-top: 6rpx; }

.task-teacher-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.teacher-anon-capsule {
  display: inline-flex;
  align-items: center;
  background: #EEF2FF;
  color: #4338CA;
  font-family: monospace;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.teacher-anon-capsule.small { padding: 6rpx 12rpx; font-size: 22rpx; }
.task-deadline { font-size: 22rpx; color: #9CA3AF; }

.task-instruction {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.6;
  background: #F9FAFB;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.task-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.task-image-type { font-size: 24rpx; color: #6B7280; }
.go-btn {
  font-size: 26rpx;
  color: #6366F1;
  font-weight: 600;
}

/* ========== 通用弹层 ========== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}
.modal-desc {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 24rpx;
  line-height: 1.5;
}
.invite-input {
  border: 2rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 36rpx;
  letter-spacing: 8rpx;
  text-align: center;
  font-family: monospace;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 32rpx;
  color: #111827;
}
.modal-btns {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.modal-btn.cancel {
  background: #F3F4F6;
  color: #4B5563;
}
.modal-btn.primary {
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  color: #fff;
}

/* ========== 任务详情弹层 ========== */
.task-modal-card {
  width: 100%;
  max-width: 680rpx;
  max-height: 86vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}
.modal-header .modal-title { margin: 0; font-size: 32rpx; max-width: 540rpx; }
.modal-close {
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #9CA3AF;
  line-height: 1;
}
.task-modal-body {
  flex: 1;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}
.detail-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.detail-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #6B7280;
}
.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
}
.detail-section {
  margin-top: 28rpx;
}
.detail-section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 12rpx;
}
.detail-section-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
  background: #F9FAFB;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.image-thumb {
  position: relative;
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}
.thumb-img {
  width: 100%;
  max-height: 420rpx;
}
.image-tap-hint {
  position: absolute;
  bottom: 12rpx;
  right: 16rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}
.feedback-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  background: #fff;
}
.text-count {
  text-align: right;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}
.task-modal-footer {
  padding: 24rpx 32rpx 32rpx;
  border-top: 1rpx solid #F3F4F6;
}
.submit-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(99,102,241,0.28);
}
.submit-btn.disabled {
  background: #9CA3AF;
  box-shadow: none;
}

.bottom-safe {
  height: 40rpx;
}
