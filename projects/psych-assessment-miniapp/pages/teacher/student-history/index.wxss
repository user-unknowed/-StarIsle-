/* pages/teacher/student-history/index.wxss · Task7 严格范围冻结 */

/* 顶部演示横幅 */
.mock-banner {
  margin: 12rpx 32rpx 0;
  background: #FFF7ED;
  border: 2rpx solid #FED7AA;
  color: #9A3412;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.title {
  font-size: 40rpx; font-weight: 700; color: #0F172A; margin-bottom: 6rpx;
}
.subtitle { margin-bottom: 20rpx; }

/* picker */
.student-picker {
  margin: 0; padding: 16rpx 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  border-radius: 20rpx;
}
.scope-label { color: #64748B; font-size: 26rpx; }
.picker-value {
  color: #3730A3; font-weight: 500; font-size: 28rpx;
  display: flex; align-items: center;
  max-width: 440rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.picker-value.placeholder { color: #94A3B8; }
.picker-value .arrow { margin-left: 8rpx; color: #A5B4FC; font-size: 22rpx; }

.error-banner {
  margin: 8rpx 32rpx 0;
  background: #FEF2F2; border: 2rpx solid #FECACA;
  color: #991B1B; padding: 16rpx 20rpx;
  border-radius: 16rpx; font-size: 24rpx;
}

/* 骨架 */
.skeleton-big {
  height: 360rpx;
  background: linear-gradient(90deg, #F1F5F9 25%, #E2E8F0 37%, #F1F5F9 63%);
  background-size: 400% 100%;
  border-radius: 24rpx;
  margin-top: 8rpx;
  animation: shimmer 1.2s infinite linear;
}
.skeleton-chart {
  height: 280rpx;
  background: linear-gradient(90deg, #F1F5F9 25%, #E2E8F0 37%, #F1F5F9 63%);
  background-size: 400% 100%;
  border-radius: 16rpx;
  animation: shimmer 1.2s infinite linear;
}
.skeleton-list { padding: 8rpx 0; }
.skeleton-row {
  height: 240rpx;
  background: linear-gradient(90deg, #F1F5F9 25%, #E2E8F0 37%, #F1F5F9 63%);
  background-size: 400% 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  animation: shimmer 1.2s infinite linear;
}
@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 引导 / 空态 */
.guide-state {
  margin: 8rpx 32rpx 0;
  padding: 48rpx 32rpx;
  text-align: center;
  border: 2rpx dashed #C7D2FE;
  background: linear-gradient(180deg, #EEF2FF 0%, #FFFFFF 100%);
  border-radius: 24rpx;
}
.guide-state.empty-whitelist {
  border-color: #E5E7EB;
  background: #FAFAFA;
}
.guide-icon { font-size: 72rpx; }
.guide-title { font-size: 30rpx; font-weight: 600; color: #334155; margin-top: 8rpx; }
.guide-desc  { font-size: 24rpx; color: #64748B; margin-top: 8rpx; line-height: 1.6; }

/* 折线图卡片 */
.chart-card { margin: 20rpx 32rpx 0; }
.section-head { margin-bottom: 16rpx; }

.chart-wrap {
  padding: 12rpx 8rpx 0;
  width: 100%;
  box-sizing: border-box;
}
.line-canvas {
  width: 100%;
  height: 460rpx;
  display: block;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #F1F5F9;
}

/* 图例（5 色严格对应 DIM_COLORS） */
.chart-legend {
  margin-top: 18rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 24rpx;
  background: #FAFBFF;
  border: 2rpx solid #EEF2FF;
  border-radius: 16rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 180rpx;
}
.legend-swatch {
  width: 28rpx; height: 12rpx;
  border-radius: 6rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.08);
}
.legend-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
  min-width: 76rpx;
}
.legend-hex {
  font-size: 18rpx;
  font-family: Menlo, Consolas, monospace;
  opacity: 0.9;
}

/* 时间轴 */
.timeline-card { margin: 20rpx 32rpx 16rpx; }

.small-empty { padding: 32rpx 24rpx; }
.empty-state {
  padding: 48rpx 24rpx;
  text-align: center;
  border-radius: 20rpx;
  background: #FAFAFC;
  border: 2rpx dashed #CBD5E1;
}
.empty-icon { font-size: 72rpx; }
.empty-state .empty-title { font-size: 28rpx; font-weight: 600; color: #334155; margin-top: 8rpx; }
.empty-state .empty-desc  { font-size: 24rpx; color: #94A3B8; margin-top: 6rpx; }

.timeline { position: relative; margin-top: 18rpx; padding-left: 28rpx; }
.timeline::before {
  content: '';
  position: absolute;
  left: 10rpx; top: 6rpx; bottom: 6rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #C7D2FE 0%, #E0E7FF 50%, #F1F5F9 100%);
  border-radius: 4rpx;
}
.tl-node { position: relative; padding-bottom: 20rpx; }
.tl-dot {
  position: absolute;
  left: -26rpx; top: 18rpx;
  width: 20rpx; height: 20rpx;
  border-radius: 50%;
  background: #6366F1;
  box-shadow: 0 0 0 4rpx #E0E7FF;
}
.tl-content {
  background: #FAFBFF;
  border: 2rpx solid #EEF2FF;
  border-radius: 20rpx;
  padding: 18rpx 20rpx 74rpx 20rpx;
  position: relative;
}
.tl-head { margin-bottom: 6rpx; }
.tl-title {
  font-size: 28rpx; font-weight: 600; color: #0F172A;
  max-width: 420rpx; margin-right: 12rpx;
}
.tl-time { font-size: 22rpx; color: #94A3B8; margin-bottom: 12rpx; }

.tl-tags {
  display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 12rpx;
}

.tl-preview {
  font-size: 24rpx; color: #475569;
  background: white;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  border: 2rpx solid #F1F5F9;
  line-height: 1.5;
}
.tl-link {
  position: absolute; right: 20rpx; bottom: 16rpx;
  font-size: 24rpx; color: #6366F1; font-weight: 500;
}

.bottom-space { height: 60rpx; }
