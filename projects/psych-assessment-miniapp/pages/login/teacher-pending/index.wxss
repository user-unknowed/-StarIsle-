.page {
  min-height: 100vh;
  background: #F3F4F6;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.hero { padding: 56rpx 36rpx; border-radius: 24rpx; text-align: center; margin-bottom: 32rpx; }
.hero.pending { background: linear-gradient(135deg,#FEF3C7 0%,#FEF9C3 100%); }
.hero.rejected { background: linear-gradient(135deg,#FEE2E2 0%,#FFE4E6 100%); }
.hero.approved { background: linear-gradient(135deg,#D1FAE5 0%,#ECFDF5 100%); }
.hero-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.hero-title { font-size: 34rpx; font-weight: 700; color: #111827; line-height: 1.4; }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; color: #4B5563; }

.tips-card {
  background: #fff; border-radius: 20rpx; padding: 32rpx 32rpx;
  box-shadow: 0 6rpx 18rpx rgba(17,24,39,0.05); margin-bottom: 32rpx;
}
.tips-title { font-size: 28rpx; font-weight: 700; color: #1F2937; margin-bottom: 18rpx; }
.tips-line { font-size: 24rpx; color: #4B5563; line-height: 1.8; }

.reject-card {
  background: #fff; border-radius: 20rpx; padding: 36rpx 32rpx;
  border-left: 8rpx solid #EF4444;
  box-shadow: 0 6rpx 18rpx rgba(17,24,39,0.05);
}
.reject-title { font-size: 28rpx; font-weight: 700; color: #B91C1C; }
.reject-reason {
  margin-top: 14rpx; padding: 20rpx; background: #FEF2F2; border-radius: 12rpx;
  color: #991B1B; font-size: 26rpx; line-height: 1.6;
}
.reject-actions { margin-top: 28rpx; display: flex; gap: 20rpx; }
.reject-actions .danger-btn { flex: 1.2; }
.reject-actions .ghost-btn { flex: 1; }

.primary-btn {
  display: block; width: 100%;
  height: 88rpx; line-height: 88rpx;
  background: #6366F1; color: #fff; border-radius: 16rpx;
  font-size: 30rpx; font-weight: 600;
}
.primary-btn.disabled { opacity: 0.6; }
.danger-btn {
  display: inline-block;
  height: 84rpx; line-height: 84rpx;
  background: #EF4444; color: #fff; border-radius: 14rpx;
  font-size: 28rpx; font-weight: 600;
}
.ghost-btn {
  display: inline-block;
  height: 84rpx; line-height: 84rpx;
  background: #F3F4F6; color: #1F2937; border-radius: 14rpx;
  font-size: 28rpx;
}

.mask {
  position: fixed; inset: 0; background: rgba(17,24,39,0.55);
  display: none; align-items: flex-end; z-index: 99;
}
.mask.show { display: flex; }
.sheet {
  width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx 60rpx; box-sizing: border-box;
  max-height: 86vh; overflow-y: auto;
}
.sheet-title { font-size: 34rpx; font-weight: 700; color: #111827; }
.sheet-sub { margin-top: 8rpx; font-size: 24rpx; color: #6B7280; }
.form { margin-top: 28rpx; }
.form-item { margin-bottom: 26rpx; }
.label { font-size: 26rpx; color: #374151; margin-bottom: 12rpx; font-weight: 600; }
.input {
  height: 80rpx; line-height: 80rpx; padding: 0 24rpx;
  background: #F9FAFB; border-radius: 12rpx; font-size: 28rpx;
  border: 2rpx solid #E5E7EB;
}
.sheet-actions { margin-top: 32rpx; display: flex; gap: 20rpx; }
.sheet-actions .ghost-btn { flex: 1; text-align: center; }
.sheet-actions .primary-btn { flex: 1.4; }
