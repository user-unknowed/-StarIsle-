<!-- pages/admin/ops-overview/index.wxml · 全局监控 Dashboard · 0 PII 渲染 -->
<view class="page-content">

  <!-- 演示数据诚实横幅（仅 Mock 模式显示） -->
  <view wx:if="{{usingMockData}}" class="mock-banner">
    <text>⚠️ 演示数据，未从云端拉取（接口暂未就绪）</text>
  </view>

  <view class="page-header">
    <view class="title-row">
      <view class="title">超级管理员 · 全局监控</view>
      <view class="subtitle">全校 KPI · 7 日趋势 · 预警 TOP20 · 全匿名</view>
    </view>
  </view>

  <view wx:if="{{errorMsg}}" class="error-banner"><text>{{errorMsg}}</text></view>

  <!-- KPI 4 卡 -->
  <view class="kpi-grid">
    <view class="kpi-card kpi-red">
      <view class="kpi-icon">🚨</view>
      <view class="kpi-value">
        <text wx:if="{{loadingKpi}}" class="kpi-skeleton">——</text>
        <text wx:else>{{kpiTodayWarnTotal}}</text>
      </view>
      <view class="kpi-title">今日全校预警</view>
      <view class="kpi-desc">listWarnings · scope=global</view>
    </view>

    <view class="kpi-card kpi-indigo">
      <view class="kpi-icon">🤖</view>
      <view class="kpi-value">
        <text wx:if="{{loadingKpi}}" class="kpi-skeleton">——</text>
        <text wx:else>{{kpiAiSuccessRate}}</text>
      </view>
      <view class="kpi-title">AI 今日成功率</view>
      <view class="kpi-desc">getBudgetStatus · successRate</view>
    </view>

    <view class="kpi-card kpi-emerald">
      <view class="kpi-icon">📤</view>
      <view class="kpi-value">
        <text wx:if="{{loadingKpi}}" class="kpi-skeleton">——</text>
        <text wx:else>{{kpiMonthExportCount}}</text>
      </view>
      <view class="kpi-title">本月导出总数</view>
      <view class="kpi-desc">listExports · admin 全校</view>
    </view>

    <view class="kpi-card kpi-blue">
      <view class="kpi-icon">✅</view>
      <view class="kpi-value">
        <text wx:if="{{loadingKpi}}" class="kpi-skeleton">——</text>
        <text wx:else>{{kpiReviewPassRate}}</text>
      </view>
      <view class="kpi-title">教师审核通过率</view>
      <view class="kpi-desc">(confirmed+adjusted)/totalReviewed</view>
    </view>
  </view>

  <!-- 近 7 日全校预警趋势条形图 · 纯 WXML/WXSS -->
  <view class="card trend-card">
    <view class="row-between section-head">
      <view class="card-title">近 7 日全校预警趋势</view>
      <view class="card-subtitle">单位：条 / 日 · 高峰 {{dayMaxCount}}</view>
    </view>
    <view wx:if="{{loadingTrend}}" class="skeleton-trend"></view>
    <view wx:else class="trend-area">
      <view class="grid-lines">
        <view class="grid-line g-0"></view>
        <view class="grid-line g-half"></view>
        <view class="grid-line g-max"></view>
      </view>
      <view class="day-columns">
        <block wx:for="{{dayBars}}" wx:key="dateLabel">
          <view class="day-col">
            <view class="day-count">{{item.count}}</view>
            <view class="day-bar" style="height: {{item.heightRpx}};"></view>
            <view class="day-label">{{item.dateLabel}}</view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 预警 TOP20（0 PII · 仅匿名 #Sxxxx） -->
  <view class="card warning-section">
    <view class="row-between section-head">
      <view class="card-title">
        预警 TOP20
        <text class="badge-warn pill pill-red">{{warningsTotal}}</text>
      </view>
      <view class="card-subtitle">全校 · 提交时间倒序</view>
    </view>

    <view wx:if="{{loadingWarnings}}" class="skeleton-list">
      <view class="skeleton-row" wx:for="{{[0,1,2,3,4]}}" wx:key="*this"></view>
    </view>

    <view wx:elif="{{emptyState && warningList.length === 0}}" class="empty-state">
      <view class="empty-icon">🗂️</view>
      <view class="empty-title">暂无全校预警</view>
      <view class="empty-desc">当前全校范围暂无预警记录，下拉刷新再试</view>
    </view>

    <view wx:else class="warning-list">
      <block wx:for="{{warningList}}" wx:key="_id">
        <view class="warning-item" catchtap="onWarningTap" data-id="{{item._id}}">
          <view class="row-between wi-head">
            <view class="wi-anon">{{item.studentAnonymousNo}}</view>
            <view class="pill {{item.reviewPillClass}}">{{item.reviewPillText}}</view>
          </view>
          <view class="wi-time">{{item.submitTimeText}}</view>
          <view class="wi-tags">
            <block wx:for="{{item.warningTags}}" wx:for-item="t" wx:key="*this">
              <view class="pill pill-warning">#{{t}}</view>
            </block>
            <view wx:if="{{item.warningTags.length === 0}}" class="pill pill-gray">（无预警标签）</view>
          </view>
          <view class="wi-action">
            <view class="wi-detail-btn">查看匿名概览</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 预警卡片点击 → 匿名化概览弹窗（0 PII · 仅 #Sxxxx / 标签 / 提交时间） -->
  <view wx:if="{{anonModalOpen}}" class="modal-mask" catchtap="onCloseAnonModal">
    <view class="modal-box" catchtap="_noop">
      <view class="modal-head">
        <view class="modal-title">匿名化预警概览</view>
        <view class="modal-close" catchtap="onCloseAnonModal">×</view>
      </view>
      <view class="modal-body" wx:if="{{anonModalData}}">
        <view class="d-row d-top">
          <view class="d-anon">{{anonModalData.studentAnonymousNo}}</view>
          <view class="pill {{anonModalData.reviewPillClass}}">{{anonModalData.reviewPillText}}</view>
        </view>
        <view class="d-meta">
          <view class="d-meta-item">📅 提交：{{anonModalData.submitTimeText}}</view>
        </view>
        <view class="d-tags">
          <block wx:for="{{anonModalData.warningTags}}" wx:for-item="t" wx:key="*this">
            <view class="pill pill-warning">#{{t}}</view>
          </block>
          <view wx:if="{{anonModalData.warningTags.length === 0}}" class="pill pill-gray">（无预警标签）</view>
        </view>
        <view class="anon-legal">
          <text>🚫 超级管理员监控视图默认不展示任何姓名/班级/手机号/证件号等 PII。\n</text>
          <text>如需查看实名信息，请到「people-crisis」页完成 2FA 双因子验证后限时 30 秒查看。</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
