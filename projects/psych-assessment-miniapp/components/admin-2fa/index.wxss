.a2fa-mask {
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.45);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.a2fa-sheet {
  width: 100%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(15,23,42,0.18);
}
.a2fa-title { font-size: 32rpx; font-weight: 600; color: #0F172A; }
.a2fa-desc { font-size: 24rpx; color: #64748B; margin-top: 8rpx; margin-bottom: 20rpx; }
.a2fa-input {
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #F9FAFB;
  margin-bottom: 16rpx;
}
.a2fa-row { display: flex; align-items: center; gap: 12rpx; }
.a2fa-flex { flex: 1; margin-bottom: 0; }
.a2fa-btn { margin-left: 12rpx; }
.a2fa-actions {
  display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx;
}
.a2fa-actions .btn-primary, .a2fa-actions .btn-ghost {
  padding: 14rpx 32rpx; min-width: 140rpx;
}
