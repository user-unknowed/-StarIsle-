# API 网关地址（Java 后端，默认端口 8081）
VITE_API_BASE_URL=http://localhost:8081/api

# AI 引擎地址（Python FastAPI，本地微调模型 sft_xiaoxing_v1）
VITE_AI_ENGINE_URL=http://localhost:8000

# WebSocket 地址（实时对话，与 Java 后端端口保持一致）
VITE_WS_URL=ws://localhost:8081/ws

# AI 对话功能开关（默认启用；设为 'false' 屏蔽 AI 对话入口与页面，用于 GitHub Pages 演示部署）
VITE_AI_CHAT_ENABLED=true
