<!-- pages/admin/people-crisis/index.wxml · 🔴 最高红线 · 0 处默认 PII -->
<!-- 合规说明：本页面 WXML 的 PII 显示字段 100% 只绑定 piiMasked.*（脱敏值 *** / 张* / 138****5678） -->
<!-- piiAuthorized=false 时，piiMasked 构造器输出固定脱敏；piiAuthorized=true 仅 30 秒内（setTimeout 到时强制回 mask）。 -->
<view class="page-content">

  <!-- 顶部合规横幅 -->
  <view class="legal-banner legal-red">
    <text>🔴 最高权限页 · 1477217 合规：本页默认 100% 匿名，0 处真名 PII。</text>
    <text>\n查看实名必须通过「密码 + SMS」双因子验证，且限时 30 秒自动强制回脱敏，每次访问写 audit_logs（仅 anonymousNo）。</text>
  </view>

  <!-- 演示数据诚实横幅（仅 Mock 模式显示） -->
  <view wx:if="{{usingMockData}}" class="mock-banner">
    <text>⚠️ 演示数据，未从云端拉取（接口暂未就绪）</text>
  </view>

  <view class="page-header">
    <view class="title">🔴 危机高危学生（全校范围）</view>
    <view class="subtitle">
      命中：self_harm_risk / suicide_ideation / severe_depression / trauma_signal / violence_risk · TOP 50
    </view>
  </view>

  <view wx:if="{{errorMsg}}" class="error-banner"><text>{{errorMsg}}</text></view>

  <!-- ========== 阶段 1：高危列表（100% 匿名） ========== -->
  <view class="card list-card">
    <view class="row-between section-head">
      <view class="card-title">
        高危学生 TOP50
        <text class="badge pill pill-red">{{crisisList.length}}</text>
      </view>
      <view class="card-subtitle">最近提交时间倒序</view>
    </view>

    <view wx:if="{{loadingList}}" class="skeleton-list">
      <view class="skeleton-row" wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this"></view>
    </view>

    <view wx:elif="{{listEmpty && crisisList.length === 0}}" class="empty-state">
      <view class="empty-icon">🟢</view>
      <view class="empty-title">未发现高危学生</view>
      <view class="empty-desc">全校范围暂无命中自伤/自杀意念/重度抑郁/创伤/暴力风险标记的记录</view>
    </view>

    <view wx:else class="crisis-list">
      <block wx:for="{{crisisList}}" wx:key="_id">
        <view class="crisis-item">
          <view class="row-between ci-head">
            <view class="ci-anon">{{item.studentAnonymousNo}}</view>
            <view class="pill pill-red">⚠️ 高危</view>
          </view>
          <view class="ci-time">最近提交：{{item.submitTimeText}}</view>
          <view class="ci-tags">
            <block wx:for="{{item.warningTagLabels}}" wx:for-item="t" wx:key="*this">
              <view class="pill pill-crisis">#{{t}}</view>
            </block>
          </view>
          <view class="ci-action">
            <button class="pii-btn" size="mini" bindtap="openPIIRequest" data-id="{{item._id}}">
              🔍 查看 PII（需 2FA）
            </button>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- ========== 🔴 阶段 2：2FA 双因子弹窗 ========== -->
  <view wx:if="{{faModalOpen}}" class="modal-mask" catchtap="closeFaModal">
    <view class="modal-box fa-box" catchtap="_noop">
      <view class="modal-head">
        <view class="modal-title">🔐 超级管理员 · 双因子 2FA（PII 访问）</view>
        <view class="modal-close" catchtap="closeFaModal">×</view>
      </view>
      <view class="modal-body">
        <view wx:if="{{faTarget}}" class="fa-target">
          <text class="fa-label">目标学生：</text>
          <text class="fa-anon">{{faTarget.studentAnonymousNo}}</text>
        </view>
        <view wx:if="{{faMessage}}" class="fa-msg">{{faMessage}}</view>

        <!-- Step 1: Factor1 密码 -->
        <view class="fa-step" wx:if="{{faStep === 1}}">
          <view class="fa-step-title">① Factor 1 · 管理员密码（adminVerifyPassword）</view>
          <view class="fa-step-desc">
            后端硬限频：密码错误 5 次 → 账号锁定 30 分钟；bcrypt cost=10
          </view>
          <input
            class="fa-input"
            password="true"
            placeholder="请输入管理员密码（演示模式密码=demo123）"
            bindinput="onFaPasswordInput"
            value="{{faPassword}}"
          />
          <button class="primary-btn btn-red" bindtap="onFaVerifyPassword" disabled="{{faVerifying}}">
            <text wx:if="{{faVerifying}}">验证中…</text>
            <text wx:else>验证密码 · 进入 Factor 2</text>
          </button>
        </view>

        <!-- Step 2: Factor2 SMS -->
        <view class="fa-step" wx:if="{{faStep === 2}}">
          <view class="fa-step-title">② Factor 2 · 短信 6 位验证码（adminSend2FACode → adminVerify2FACode）</view>
          <view class="fa-step-desc">
            后端硬限频：5 次/小时；验证码 5 分钟内有效。发送号码：{{faMfaPhone || '（已登记）'}}
          </view>
          <view class="fa-row">
            <input
              class="fa-input fa-flex"
              placeholder="6 位数字验证码（演示模式=123456）"
              maxlength="6"
              bindinput="onFaCodeInput"
              value="{{faCode}}"
              type="number"
            />
            <button class="btn-ghost btn-mini" bindtap="onFaSendCode" disabled="{{faSending}}">
              <text wx:if="{{faSending}}">发送中</text>
              <text wx:else>发送验证码</text>
            </button>
          </view>
          <button class="primary-btn btn-red" bindtap="onFaVerifyCode" disabled="{{faVerifying}}">
            <text wx:if="{{faVerifying}}">验证中…</text>
            <text wx:else>验证 · 开启 30 秒实名窗口</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 🔴🔴🔴 阶段 3：30 秒 PII 窗口（WXML 只绑 piiMasked · 授权时切换 piiReal） ========== -->
  <!-- 🔴 默认 0 处明文：未授权时 piiAuthorized=false → 内层只绑定 piiMasked.*（*** / 张* / 138****5678） -->
  <view wx:if="{{piiTargetAnonNo}}" class="card pii-card">
    <view class="row-between section-head pii-head">
      <view>
        <view class="card-title">
          {{piiAuthorized ? '🟡 实名窗口 · 限时 30 秒' : '⚪ 未授权 · 已脱敏（***）'}}
          <text wx:if="{{piiTargetAnonNo}}" class="badge pill pill-purple">{{piiTargetAnonNo}}</text>
        </view>
        <view class="card-subtitle" wx:if="{{piiAuthorized}}">剩余：{{countdownText}} · 到时自动强制回脱敏 + 清空内存 + audit_logs</view>
        <view class="card-subtitle" wx:else>请点击「查看 PII（需 2FA）」完成双因子验证后限时查看</view>
      </view>
      <view wx:if="{{piiAuthorized}}">
        <button class="btn-ghost btn-mini btn-close-pii" bindtap="onManualClosePII">手动关闭</button>
      </view>
    </view>

    <!-- PII 字段 网格 · 🔴 绑定规则：授权时 piiReal.* 覆盖 piiMasked.*；未授权仅 piiMasked.*（100% 脱敏） -->
    <view class="pii-grid">
      <view class="pii-cell">
        <view class="pii-label">学生姓名</view>
        <view class="pii-value">
          <!-- 未授权：mask 版；授权：piiReal（30s 到时被 setData 为 null 后，自动回 mask 版） -->
          <text>{{(piiAuthorized && piiReal && piiReal.studentName) || piiMasked.studentName}}</text>
        </view>
      </view>
      <view class="pii-cell">
        <view class="pii-label">手机号</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.phone) || piiMasked.phone}}</text>
        </view>
      </view>
      <view class="pii-cell">
        <view class="pii-label">身份证号</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.idCardNo) || piiMasked.idCardNo}}</text>
        </view>
      </view>
      <view class="pii-cell">
        <view class="pii-label">班级</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.className) || piiMasked.className}}</text>
        </view>
      </view>
      <view class="pii-cell">
        <view class="pii-label">年级</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.grade) || piiMasked.grade}}</text>
        </view>
      </view>
      <view class="pii-cell">
        <view class="pii-label">学校</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.school) || piiMasked.school}}</text>
        </view>
      </view>
      <view class="pii-cell pii-cell-wide">
        <view class="pii-label">家庭地址</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.address) || piiMasked.address}}</text>
        </view>
      </view>
      <view class="pii-cell">
        <view class="pii-label">家长姓名</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.parentName) || piiMasked.parentName}}</text>
        </view>
      </view>
      <view class="pii-cell">
        <view class="pii-label">家长手机号</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.parentPhone) || piiMasked.parentPhone}}</text>
        </view>
      </view>
      <view class="pii-cell pii-cell-wide">
        <view class="pii-label">其他联系人</view>
        <view class="pii-value">
          <text>{{(piiAuthorized && piiReal && piiReal.otherContacts) || piiMasked.otherContacts}}</text>
        </view>
      </view>
    </view>

    <view class="pii-legal">
      <text>🔒 合规记录：本 PII 访问已写入 audit_logs（仅 anonymousNo），动作类型：</text>
      <block wx:if="{{piiAuthorized}}">grant ➜ 30 秒到时 / 手动关闭 追加写入。</block>
      <block wx:else>（未授权 / 已 auto_clear_30s / manual_close）。</block>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
