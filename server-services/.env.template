# 星屿项目环境变量配置模板
# 生产环境请替换为真实值

# 应用环境
ENVIRONMENT=development

# MySQL数据库
MYSQL_PASSWORD=password123
MYSQL_ROOT_PASSWORD=root_password_2026
DATABASE_URL=jdbc:mysql://localhost:3306/starisle?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DATABASE_USERNAME=starisle_user
DATABASE_PASSWORD=password123
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# MongoDB数据库
MONGODB_URL=mongodb://starisle_admin:password123@localhost:27017/starisle
MONGO_PASSWORD=password123

# Redis缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password123

# JWT认证
JWT_SECRET=starisle_jwt_secret_key_2026_must_be_32_characters_min

# 加密密钥管理
ENCRYPTION_KEY=starisle_encryption_key_2026_base64_encoded_32_bytes
ENCRYPTION_MASTER_KEY=starisle_master_key_2026_must_be_32_bytes_for_aes256

# AI模型配置
MODEL_NAME=deepseek-ai/deepseek-chat
MODEL_API_KEY=your_api_key_here
MODEL_API_BASE=https://api.deepseek.com
AI_SERVICE_URL=http://localhost:8000

# API配置
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000

# 速率限制
RATE_LIMIT_RPS=100

# 日志配置
LOG_LEVEL=info
SHOW_SQL=true
FORMAT_SQL=true

# 安全配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TLS_ENABLED=false

# 数据迁移配置
MIGRATION_SOURCE_URL=jdbc:h2:mem:starisle;DB_CLOSE_DELAY=-1
MIGRATION_SOURCE_USERNAME=sa
MIGRATION_SOURCE_PASSWORD=
MIGRATION_SOURCE_DRIVER=org.h2.Driver
