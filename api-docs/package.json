{
  "name": "starisle-api-docs",
  "private": true,
  "version": "0.0.0",
  "description": "星屿 StarIsle API 文档工具",
  "author": "StarIsle",
  "repository": {
    "type": "git",
    "url": "https://github.com/user-unknowed/-StarIsle-.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "main": "electron/main.js",
  "dependencies": {
    "@scalar/api-client": "^3.13.7",
    "@scalar/api-reference-react": "^0.9.54",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.starisle.apidocs",
    "productName": "星屿API文档",
    "copyright": "Copyright © 2026 StarIsle",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Development"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ]
  }
}
