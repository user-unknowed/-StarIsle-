/* pages/student/my-records/index.wxss */
.page {
  min-height: 100vh;
  background: #F3F4F6;
  padding: 24rpx;
  box-sizing: border-box;
}

.demo-top-tip {
  display: flex;
  align-items: center;
  background: #FEF3C7;
  color: #92400E;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  gap: 10rpx;
}
.demo-tip-icon { font-size: 28rpx; }

.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}
.spinner {
  width: 60rpx; height: 60rpx;
  border: 6rpx solid #E5E7EB;
  border-top-color: #6366F1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-tip { color: #6B7280; font-size: 26rpx; }

.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 32rpx; color: #1F2937; font-weight: 600; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #6B7280; text-align: center; line-height: 1.6; }

.record-list { display: flex; flex-direction: column; gap: 20rpx; }
.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.record-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.record-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  flex: 1;
}

/* ===== reviewStatus 三色胶囊 ===== */
.review-capsule {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
}
.review-capsule.status-gray { background: #E5E7EB; color: #4B5563; }
.review-capsule.status-green { background: #D1FAE5; color: #065F46; }
.review-capsule.status-orange { background: #FED7AA; color: #9A3412; }
.review-capsule-inline {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.review-capsule-inline.status-gray { background: #E5E7EB; color: #4B5563; }
.review-capsule-inline.status-green { background: #D1FAE5; color: #065F46; }
.review-capsule-inline.status-orange { background: #FED7AA; color: #9A3412; }

.record-time { font-size: 24rpx; color: #9CA3AF; margin-bottom: 14rpx; }
.record-preview {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
  background: #F9FAFB;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  margin-bottom: 18rpx;
}

.record-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

/* ===== AI 预警 红色胶囊 ===== */
.warning-capsule {
  background: #FEE2E2;
  color: #B91C1C;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.no-warning { font-size: 22rpx; color: #9CA3AF; }
.go-detail { font-size: 26rpx; color: #6366F1; font-weight: 600; flex-shrink: 0; }

/* ===== 详情弹层 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
  box-sizing: border-box;
}
.detail-modal-card {
  width: 100%;
  max-width: 680rpx;
  max-height: 86vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}
.modal-header .modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}
.modal-close {
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #9CA3AF;
  line-height: 1;
}
.detail-body {
  flex: 1;
  padding: 24rpx 32rpx 0;
}
.detail-block {
  margin-bottom: 28rpx;
}
.detail-block-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 14rpx;
}
.detail-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.detail-line .k { color: #6B7280; width: 100rpx; flex-shrink: 0; }
.detail-line .v { color: #111827; flex: 1; }

.warning-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.warning-tag-item {
  background: #FEE2E2;
  color: #B91C1C;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.no-warning-detail { font-size: 24rpx; color: #9CA3AF; }

.my-content {
  font-size: 26rpx;
  line-height: 1.7;
  color: #1F2937;
  background: #F9FAFB;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  white-space: pre-wrap;
}
.image-feedback-item {
  background: #F9FAFB;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}
.fb-label { font-size: 22rpx; color: #6B7280; margin-bottom: 6rpx; }
.fb-text { font-size: 26rpx; color: #1F2937; line-height: 1.6; white-space: pre-wrap; }
.no-content { font-size: 24rpx; color: #9CA3AF; }

.ai-summary {
  font-size: 26rpx;
  line-height: 1.7;
  color: #1F2937;
  background: #EEF2FF;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  white-space: pre-wrap;
}

.privacy-note {
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: center;
  line-height: 1.6;
  padding: 10rpx 0 30rpx;
}

.detail-footer {
  padding: 20rpx 32rpx 32rpx;
  border-top: 1rpx solid #F3F4F6;
}
.close-btn {
  width: 100%;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  background: #F3F4F6;
  color: #374151;
  font-size: 28rpx;
  font-weight: 600;
}

.bottom-safe { height: 40rpx; }
