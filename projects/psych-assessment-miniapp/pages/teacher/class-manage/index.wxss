/* pages/teacher/class-manage/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx 24rpx;
  box-sizing: border-box;
  background: #F3F4F6;
}

/* ========== 顶部操作栏 ========== */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 4rpx 8rpx;
}
.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}
.page-subtitle {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

/* ========== 状态提示 ========== */
.state-bar {
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #EEF2FF;
  color: #4338CA;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.state-err { background: #FEF2F2; color: #B91C1C; }

/* ========== 创建班级卡片 ========== */
.create-card {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(99,102,241,0.35);
  color: #fff;
}
.create-card .cc-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.create-card .cc-form {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.cc-input {
  background: rgba(255,255,255,0.18);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  color: #fff;
  font-size: 26rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}
.cc-input::placeholder { color: rgba(255,255,255,0.65); }
.cc-btn {
  background: #fff;
  color: #6366F1;
  border-radius: 12rpx;
  padding: 18rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.btn-hover { opacity: 0.85; }

/* ========== 班级列表卡片 ========== */
.class-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.class-card .cc-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}
.class-card .cc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}
.class-card .cc-grade {
  font-size: 24rpx;
  color: #6366F1;
  margin-top: 6rpx;
  font-weight: 500;
}
.cc-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: flex-end;
}
.cc-mini-btn {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  text-align: center;
  font-weight: 500;
}
.btn-reset {
  background: #EEF2FF;
  color: #4338CA;
}
.btn-delete {
  background: #FEF2F2;
  color: #DC2626;
}

/* ========== 邀请码胶囊 ========== */
.invite-capsule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 999rpx;
  padding: 14rpx 20rpx 14rpx 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #F59E0B;
}
.invite-label {
  font-size: 24rpx;
  color: #92400E;
  font-weight: 500;
}
.invite-code {
  font-size: 32rpx;
  font-weight: 700;
  color: #B45309;
  letter-spacing: 6rpx;
  font-family: 'Courier New', monospace;
}
.copy-btn {
  background: #F59E0B;
  color: #fff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* ========== 学生统计 ========== */
.student-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid #F3F4F6;
  border-bottom: 1rpx solid #F3F4F6;
  margin-bottom: 16rpx;
}
.student-count {
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
}
.student-count .num {
  color: #6366F1;
  font-size: 30rpx;
  margin: 0 4rpx;
}
.toggle-students {
  font-size: 24rpx;
  color: #6366F1;
  font-weight: 500;
}

/* ========== 学生列表 ========== */
.student-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 8rpx;
}
.student-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}
.student-anon {
  font-size: 26rpx;
  color: #1F2937;
  font-family: 'Courier New', monospace;
  font-weight: 600;
}
.student-index {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-right: 10rpx;
}
.btn-remove-student {
  background: #FEF2F2;
  color: #DC2626;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.empty-students {
  padding: 20rpx;
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
}

.empty-classes {
  background: #fff;
  border: 1rpx dashed #C7D2FE;
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.8;
}
.empty-classes .emoji {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}
