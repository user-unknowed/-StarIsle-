/* pages/student/profile/index.wxss */
.page {
  min-height: 100vh;
  background: #F3F4F6;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 匿名编号 ===== */
.anon-card {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(99, 102, 241, 0.28);
  margin-bottom: 28rpx;
}
.anon-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}
.anon-big-capsule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.18);
  border: 2rpx solid rgba(255,255,255,0.35);
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}
.anon-no {
  font-family: monospace;
  font-size: 56rpx;       /* 大字号 28~32px */
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.12);
}
.anon-tip {
  font-size: 22rpx;
  opacity: 0.9;
  line-height: 1.6;
  padding: 0 20rpx;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  margin-bottom: 20rpx;
}
.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}
.class-count {
  font-size: 22rpx;
  color: #6B7280;
}
.card-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.card-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #6B7280;
  flex-shrink: 0;
}
.nickname-value {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
  font-weight: 500;
}
.nickname-input {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
  border-bottom: 2rpx solid #6366F1;
  padding: 8rpx 4rpx;
}
.edit-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #EEF2FF;
  color: #4338CA;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.edit-btn.cancel {
  background: #F3F4F6;
  color: #6B7280;
}
.edit-btn.save {
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  color: #fff;
}

/* ===== 班级列表 ===== */
.mini-loading {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 20rpx 0;
}
.classes-empty {
  padding: 30rpx 10rpx;
  text-align: center;
}
.classes-empty-text {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
}
.class-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.class-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F9FAFB;
  padding: 20rpx;
  border-radius: 14rpx;
}
.class-info { flex: 1; }
.class-name {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.class-grade {
  font-size: 22rpx;
  color: #9CA3AF;
}
.teacher-anon-capsule {
  display: inline-flex;
  align-items: center;
  background: #EEF2FF;
  color: #4338CA;
  font-family: monospace;
  font-size: 22rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 退出登录 ===== */
.logout-wrap {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logout-btn {
  width: 100%;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  background: #fff;
  color: #DC2626;
  font-size: 30rpx;
  font-weight: 700;
  border: 2rpx solid #FECACA;
  margin-bottom: 16rpx;
}
.logout-tip {
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: center;
  line-height: 1.6;
  padding: 0 30rpx;
}

.bottom-safe { height: 40rpx; }
