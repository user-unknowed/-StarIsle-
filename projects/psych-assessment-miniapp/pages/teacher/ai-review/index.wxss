/* pages/teacher/ai-review/index.wxss */
.page {
  background: #F3F4F6;
  min-height: 100vh;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

/* ===== 演示数据 Banner ===== */
.demo-banner {
  background: linear-gradient(90deg, #FFF7ED, #FEF3C7);
  color: #92400E;
  font-size: 24rpx;
  line-height: 1.55;
  padding: 14rpx 24rpx;
  border-bottom: 2rpx solid #F59E0B;
}

/* ===== 顶部双 Tab ===== */
.top-tabs {
  display: flex;
  background: #ffffff;
  border-bottom: 2rpx solid #E5E7EB;
  position: sticky;
  top: 0;
  z-index: 10;
}
.top-tab {
  flex: 1;
  padding: 26rpx 0 22rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #6B7280;
  position: relative;
}
.top-tab.on {
  color: #4F46E5;
}
.top-tab.on::after {
  content: "";
  position: absolute;
  left: 30%;
  right: 30%;
  bottom: 0;
  height: 4rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #4F46E5;
}
.tt-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  opacity: 0.8;
  font-weight: 500;
}

/* ===== 筛选条 ===== */
.filter-row {
  background: #ffffff;
  padding: 16rpx 24rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border-bottom: 2rpx solid #F1F5F9;
}
.filter-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.fg-label {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 600;
  flex-shrink: 0;
}
.fg-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.fg-opt {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #F1F5F9;
  color: #475569;
  font-size: 24rpx;
  font-weight: 500;
}
.fg-opt.on {
  background: #EEF2FF;
  color: #4338CA;
  font-weight: 600;
  border: 2rpx solid #C7D2FE;
}

/* ===== 状态条 ===== */
.state-bar {
  margin: 12rpx 24rpx;
  padding: 12rpx 20rpx;
  background: #EFF6FF;
  border-radius: 12rpx;
  color: #1E40AF;
  font-size: 24rpx;
  text-align: center;
}
.state-bar.state-err {
  background: #FEF2F2;
  color: #B91C1C;
}

/* ===== 列表卡片 ===== */
.list-wrap {
  padding: 16rpx 24rpx;
}
.card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.anon-capsule {
  background: #E0E7FF;
  color: #3730A3;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
  font-size: 24rpx;
}
.submit-time {
  font-size: 22rpx;
  color: #94A3B8;
}
.preview {
  margin-top: 14rpx;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
  align-items: center;
}

/* ===== 状态胶囊（三色） ===== */
.st-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
/* pending 蓝 */
.pill-st-pending { background: #DBEAFE; color: #1D4ED8; }
/* AI失败 橙 */
.pill-st-ai-failed { background: #FFEDD5; color: #C2410C; }
/* AI跳过 紫 */
.pill-st-ai-skipped { background: #EDE9FE; color: #6D28D9; }
/* 已确认 / 已调整 绿/深灰 */
.pill-st-reviewed { background: #D1FAE5; color: #065F46; }

/* ===== 预警标签红胶囊 ===== */
.warn-tag {
  background: #FEE2E2;
  color: #991B1B;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.empty-list {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #94A3B8;
  font-size: 26rpx;
  line-height: 1.9;
  white-space: pre-line;
}

/* ===== 详情弹层 ===== */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 100;
}
.detail-panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  top: 80rpx;
  background: #F3F4F6;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 28rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #E5E7EB;
  flex-shrink: 0;
}
.detail-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}
.detail-st { padding: 8rpx 18rpx; font-size: 22rpx; }

.detail-scroll {
  flex: 1;
  padding: 20rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* msSec 合规条 / AI 失败条 */
.mssec-bar, .ai-failed-bar {
  background: #FEE2E2;
  border: 2rpx solid #FECACA;
  color: #991B1B;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.55;
  margin-bottom: 16rpx;
}
.ai-failed-bar {
  background: #FFF7ED;
  border-color: #FED7AA;
  color: #9A3412;
}
.mssec-title {
  font-weight: 700;
  margin-bottom: 6rpx;
  font-size: 26rpx;
}

/* ===== 左右双栏 ===== */
.two-col {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: flex-start;
}
.col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.col-left {
  max-width: 46%;
}
.col-right {
  max-width: 54%;
}

.col-sec-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2937;
  padding: 2rpx 0;
}

/* 左列：逐图原文卡 */
.seg-card {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 14rpx;
  box-shadow: 0 1rpx 6rpx rgba(15, 23, 42, 0.04);
}
.seg-head { margin-bottom: 8rpx; }
.seg-index {
  display: inline-block;
  background: #EEF2FF;
  color: #4338CA;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.seg-img {
  width: 100%;
  border-radius: 10rpx;
  background: #F1F5F9;
  margin-bottom: 10rpx;
}
.seg-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #1F2937;
  white-space: pre-wrap;
  word-break: break-all;
}
.seg-empty {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 24rpx;
  color: #94A3B8;
  font-size: 24rpx;
}

/* 右上 AI 结论卡 */
.ai-card, .reviewed-card, .action-card {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 18rpx;
  box-shadow: 0 1rpx 6rpx rgba(15, 23, 42, 0.04);
}
.ai-sub-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748B;
  margin: 6rpx 0 10rpx;
}

/* 条形评分 */
.score-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 4rpx 0;
}
.score-label {
  width: 80rpx;
  font-size: 22rpx;
  color: #475569;
  flex-shrink: 0;
}
.score-bg {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: #F1F5F9;
  overflow: hidden;
}
.score-fg {
  height: 100%;
  border-radius: 999rpx;
}
.score-fg.color-low-risk  { background: linear-gradient(90deg, #10B981, #059669); }
.score-fg.color-mid-risk  { background: linear-gradient(90deg, #F59E0B, #D97706); }
.score-fg.color-high-risk { background: linear-gradient(90deg, #EF4444, #DC2626); }
.score-val {
  width: 90rpx;
  text-align: right;
  font-size: 22rpx;
  color: #0F172A;
  font-weight: 700;
  flex-shrink: 0;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.ai-empty {
  color: #94A3B8;
  font-size: 22rpx;
  padding: 4rpx 0;
}
.summary-box {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
  color: #1F2937;
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 已审核记录卡 */
.reviewed-line {
  font-size: 24rpx;
  color: #1F2937;
  line-height: 1.6;
}
.reviewed-line.muted {
  color: #64748B;
  font-size: 22rpx;
}
.private-note {
  margin-top: 12rpx;
  background: #FFFBEB;
  border: 2rpx dashed #FBBF24;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.6;
}
.private-note-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #78350F;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ===== 按钮 ===== */
.btn {
  width: 100%;
  border-radius: 14rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  margin: 10rpx 0 !important;
  border: none !important;
  padding: 16rpx 0 !important;
  line-height: 1.4;
}
.btn-confirm {
  background: linear-gradient(135deg, #10B981, #059669) !important;
  color: #ffffff !important;
}
.btn-confirm.disabled {
  background: #9CA3AF !important;
  color: #E5E7EB !important;
}
.btn-adjust-toggle {
  background: linear-gradient(135deg, #6366F1, #8B5CF6) !important;
  color: #ffffff !important;
}
.btn-save-adjust {
  background: linear-gradient(135deg, #4F46E5, #7C3AED) !important;
  color: #ffffff !important;
  margin-top: 18rpx !important;
}
.btn-cancel {
  background: #F1F5F9 !important;
  color: #475569 !important;
  margin-top: 16rpx !important;
}
.btn-hint {
  font-size: 22rpx;
  line-height: 1.55;
  color: #64748B;
  padding: 0 6rpx;
  margin-top: -4rpx;
}
.btn-hint.warn { color: #B91C1C; }

/* ===== 调整面板 ===== */
.adjust-panel {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 14rpx;
  border: 2rpx solid #E2E8F0;
}
.ap-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  margin: 8rpx 0 10rpx;
}
.muted { color: #94A3B8; font-weight: 500; }
.small { font-size: 20rpx; }

/* slider */
.slider-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 0;
}
.slider-name {
  width: 90rpx;
  font-size: 24rpx;
  color: #334155;
  font-weight: 600;
  flex-shrink: 0;
}
.slider-el {
  flex: 1;
  min-width: 0;
}

/* 标签多选网格（10 白名单） */
.tag-pick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}
.tag-pick {
  display: flex;
  flex-direction: column;
  padding: 10rpx 12rpx;
  background: #ffffff;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  line-height: 1.35;
}
.tag-pick.on {
  background: #FEE2E2;
  border-color: #F87171;
  box-shadow: 0 0 0 2rpx rgba(248,113,113,0.15);
}
.tp-key {
  font-size: 20rpx;
  color: #475569;
  font-family: Menlo, Consolas, monospace;
  word-break: break-all;
}
.tag-pick.on .tp-key { color: #7F1D1D; font-weight: 600; }
.tp-label {
  font-size: 24rpx;
  color: #0F172A;
  font-weight: 600;
  margin-top: 2rpx;
}

/* textarea */
.ap-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  color: #0F172A;
  line-height: 1.65;
  min-height: 140rpx;
}
.ap-textarea.note {
  min-height: 180rpx;
}
.private-hint {
  font-size: 22rpx;
  color: #7C2D12;
  background: #FFF7ED;
  border-left: 6rpx solid #F97316;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  line-height: 1.45;
}

/* ===== 小屏兼容：双栏在窄屏堆叠 ===== */
@media (max-width: 340px) {
  .two-col { flex-direction: column; }
  .col-left, .col-right { max-width: 100%; }
}
