/* pages/admin/people-crisis/index.wxss · 🔴 最高红线 合规页样式 */

.page-content { min-height: 100vh; background: #F3F4F6; padding-bottom: 32rpx; }

/* 合规横幅 */
.legal-banner {
  margin: 12rpx 32rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  font-size: 24rpx; line-height: 1.6; font-weight: 500;
}
.legal-red {
  background: #FEF2F2; border: 2rpx solid #FECACA; color: #7F1D1D;
}

/* 演示数据诚实横幅（橙色） */
.mock-banner {
  margin: 12rpx 32rpx 0;
  background: #FFF7ED; border: 2rpx solid #FED7AA;
  color: #9A3412; padding: 14rpx 20rpx;
  border-radius: 16rpx; font-size: 24rpx; font-weight: 600; letter-spacing: 0.5rpx;
}
.error-banner {
  margin: 8rpx 32rpx 0;
  background: #FEF2F2; border: 2rpx solid #FECACA;
  color: #991B1B; padding: 16rpx 20rpx;
  border-radius: 16rpx; font-size: 24rpx;
}

.page-header { padding: 20rpx 32rpx 8rpx; }
.title { font-size: 38rpx; font-weight: 700; color: #0F172A; letter-spacing: 0.5rpx; }
.subtitle { margin-top: 6rpx; font-size: 24rpx; color: #64748B; line-height: 1.5; }

/* 通用卡片 */
.card {
  background: white; border-radius: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(15,23,42,0.05);
  padding: 24rpx;
  margin: 16rpx 32rpx 0;
}
.section-head { margin-bottom: 16rpx; }
.row-between { display: flex; justify-content: space-between; align-items: center; }
.card-title { font-size: 30rpx; font-weight: 700; color: #0F172A; }
.card-subtitle { font-size: 22rpx; color: #64748B; margin-top: 4rpx; }

/* Pills */
.pill { display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600; }
.pill-red { background: #FEE2E2; color: #B91C1C; }
.pill-gray { background: #F1F5F9; color: #475569; }
.pill-purple { background: #EDE9FE; color: #5B21B6; }
.pill-crisis {
  background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
  color: #991B1B; border: 2rpx solid #FECACA;
}
.badge { margin-left: 10rpx; vertical-align: middle; }

/* 骨架 */
.skeleton-list { padding: 8rpx 0; }
.skeleton-row {
  height: 140rpx;
  background: linear-gradient(90deg, #F1F5F9 25%, #E2E8F0 37%, #F1F5F9 63%);
  background-size: 400% 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  animation: shimmer 1.2s infinite linear;
}
@keyframes shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

/* 空态 */
.empty-state { padding: 64rpx 24rpx; text-align: center; border-radius: 20rpx; background: #FAFAFC; border: 2rpx dashed #CBD5E1; }
.empty-icon { font-size: 72rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #334155; margin-top: 8rpx; }
.empty-desc  { font-size: 24rpx; color: #94A3B8; margin-top: 8rpx; line-height: 1.6; }

/* 高危列表 */
.list-card { margin: 16rpx 32rpx 0; }
.crisis-list { display: flex; flex-direction: column; gap: 16rpx; }
.crisis-item {
  background: #FFF5F5; border: 2rpx solid #FECACA;
  border-radius: 20rpx; padding: 20rpx 22rpx 90rpx 22rpx; position: relative;
}
.ci-head { margin-bottom: 8rpx; }
.ci-anon { font-size: 28rpx; font-weight: 700; color: #991B1B; letter-spacing: 0.5rpx; }
.ci-time { font-size: 22rpx; color: #94A3B8; margin-bottom: 10rpx; }
.ci-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 10rpx; }
.ci-action { position: absolute; right: 22rpx; bottom: 18rpx; }

.pii-btn {
  background: linear-gradient(135deg, #DC2626 0%, #991B1B 100%) !important;
  color: white !important; border: none !important;
  font-size: 24rpx !important; font-weight: 600 !important;
  padding: 10rpx 20rpx !important; border-radius: 24rpx !important;
}
.pii-btn::after { border: none !important; }

/* ========= 2FA 弹窗 ========= */
.modal-mask {
  position: fixed; inset: 0;
  background: rgba(15, 23, 42, 0.55); z-index: 999;
  display: flex; align-items: center; justify-content: center;
  padding: 60rpx 32rpx;
}
.modal-box {
  width: 100%; max-height: 85vh;
  background: white; border-radius: 28rpx; overflow: hidden;
  display: flex; flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(15,23,42,0.3);
}
.modal-head {
  padding: 28rpx 32rpx 20rpx; display: flex; justify-content: space-between; align-items: center;
  border-bottom: 2rpx solid #F1F5F9;
  background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
}
.modal-title { font-size: 32rpx; font-weight: 700; color: #7F1D1D; flex: 1; margin-right: 16rpx; }
.modal-close {
  width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; font-size: 40rpx;
  color: #991B1B; background: white; border-radius: 50%;
}
.modal-body { padding: 24rpx 32rpx 32rpx; overflow-y: auto; max-height: 65vh; }

.fa-target { margin-bottom: 12rpx; }
.fa-label { font-size: 24rpx; color: #64748B; }
.fa-anon { font-size: 28rpx; font-weight: 700; color: #5B21B6; }
.fa-msg {
  background: #FFF7ED; border: 2rpx solid #FED7AA; color: #9A3412;
  padding: 14rpx 18rpx; border-radius: 14rpx; font-size: 24rpx; line-height: 1.6;
  margin-bottom: 16rpx;
}
.fa-step {
  background: #FAFBFF; border: 2rpx solid #EEF2FF; border-radius: 18rpx;
  padding: 20rpx; margin-top: 12rpx;
}
.fa-step-title { font-size: 28rpx; font-weight: 700; color: #3730A3; margin-bottom: 8rpx; }
.fa-step-desc { font-size: 22rpx; color: #64748B; margin-bottom: 14rpx; line-height: 1.6; }

.fa-input {
  background: white; border: 2rpx solid #E2E8F0; border-radius: 14rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #0F172A;
  margin-bottom: 14rpx;
}
.fa-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 14rpx; }
.fa-flex { flex: 1; margin-bottom: 0; }

.btn-ghost {
  background: white !important; color: #3730A3 !important;
  border: 2rpx solid #C7D2FE !important; border-radius: 16rpx !important;
  font-size: 24rpx !important; font-weight: 600 !important;
  padding: 10rpx 20rpx !important;
}
.btn-ghost::after { border: none !important; }
.btn-mini { font-size: 24rpx !important; padding: 10rpx 20rpx !important; }

.primary-btn {
  margin-top: 12rpx; padding: 22rpx 0;
  border-radius: 20rpx; font-size: 30rpx; font-weight: 600;
  color: white; border: none;
}
.primary-btn::after { border: none; }
.btn-red { background: linear-gradient(135deg, #DC2626 0%, #991B1B 100%); }
button[disabled] { opacity: 0.6; }

/* ========= PII 卡片 ========= */
.pii-card { margin: 20rpx 32rpx 0; border: 2rpx solid #5B21B6; background: #FAF5FF; }
.pii-head { align-items: flex-start; }
.btn-close-pii { color: #7F1D1D !important; border-color: #FECACA !important; }

.pii-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 12rpx;
}
.pii-cell {
  background: white; border: 2rpx solid #EDE9FE; border-radius: 16rpx;
  padding: 16rpx 18rpx;
}
.pii-cell-wide { grid-column: span 2; }
.pii-label { font-size: 22rpx; color: #5B21B6; font-weight: 600; margin-bottom: 6rpx; }
.pii-value {
  font-size: 30rpx; font-weight: 600; color: #0F172A;
  word-break: break-all; letter-spacing: 0.3rpx;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.pii-legal {
  margin-top: 18rpx; padding: 16rpx 18rpx;
  background: #FEF3C7; border: 2rpx solid #FDE68A;
  color: #78350F; font-size: 24rpx; line-height: 1.6;
  border-radius: 14rpx;
}

.bottom-space { height: 60rpx; }
