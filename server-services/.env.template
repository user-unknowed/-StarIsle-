# =============================================================================
# 星屿项目环境变量配置模板
# 生产环境请通过 Secret Manager / Vault / kubectl create secret 注入真实值
# 切勿将真实凭据提交到版本控制
# =============================================================================

# 应用环境
ENVIRONMENT=development

# PostgreSQL数据库 (统一数据库选型)
POSTGRES_DB=starisle
POSTGRES_USER=starisle_user
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=jdbc:postgresql://localhost:5432/starisle
DATABASE_USERNAME=starisle_user
DATABASE_PASSWORD=change_me_postgres_password
DATABASE_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# MongoDB数据库
MONGODB_URL=mongodb://starisle_admin:change_me_mongo_password@localhost:27017/starisle
MONGO_PASSWORD=change_me_mongo_password

# Redis缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# JWT认证 (>= 32 字符)
JWT_SECRET=change_me_jwt_secret_key_at_least_32_characters_long

# 加密密钥管理 (AES-256, 32 字节)
ENCRYPTION_KEY=change_me_encryption_key_32_bytes_long_
ENCRYPTION_MASTER_KEY=change_me_master_key_32_bytes_long_

# AI模型配置
MODEL_NAME=deepseek-ai/deepseek-chat
MODEL_API_KEY=your_api_key_here
MODEL_API_BASE=https://api.deepseek.com
AI_SERVICE_URL=http://localhost:8000

# API配置
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000

# 速率限制
RATE_LIMIT_RPS=100

# 日志配置 (生产环境应关闭 SQL 日志)
LOG_LEVEL=info
SHOW_SQL=false
FORMAT_SQL=false

# 安全配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TLS_ENABLED=false

# 数据迁移配置 (H2 -> PostgreSQL 迁移用)
MIGRATION_SOURCE_URL=jdbc:h2:mem:starisle;DB_CLOSE_DELAY=-1
MIGRATION_SOURCE_USERNAME=sa
MIGRATION_SOURCE_PASSWORD=
MIGRATION_SOURCE_DRIVER=org.h2.Driver
