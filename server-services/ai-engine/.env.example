# ai-engine 环境变量示例（复制为 .env 后按需修改）
# 本地推理开关：true 时加载本仓库 SFT 微调产物，不调用外部 API
USE_LOCAL_MODEL=true

# 本地模型目录；留空则默认 ./models/sft_xiaoxing_v1/final_model
MODEL_NAME=./models/sft_xiaoxing_v1/final_model

# USE_LOCAL_MODEL=false 时使用的 OpenAI 兼容接口
MODEL_API_KEY=
MODEL_API_BASE=https://api.deepseek.com

# HuggingFace 在线下载：国内直连超时可改用镜像站
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
EMOTION_MODEL=bert-base-chinese

# MongoDB；不可用时 KnowledgeService 自动降级为内存模式
MONGODB_URL=mongodb://localhost:27017/starisle
