{
  "$metadata": {
    "tokenSetName": "psych-healing",
    "version": "1.0.0",
    "description": "疗愈独立色板与桥接 token（Spec §4.1）",
    "author": "starlisle"
  },
  "$theme": {
    "color": {
      "cream": {
        "100": {
          "$value": "#FBF5EA",
          "$type": "color",
          "$description": "奶油米 · 背景"
        }
      },
      "green": {
        "600": {
          "$value": "#3C765C",
          "$type": "color",
          "$description": "森林绿 · 主色"
        },
        "800": {
          "$value": "#264F3D",
          "$type": "color",
          "$description": "深森林绿 · 强调/文本"
        }
      },
      "pink": {
        "200": {
          "$value": "#F5DAD4",
          "$type": "color",
          "$description": "薄纱粉 · 柔色"
        }
      },
      "blue": {
        "300": {
          "$value": "#BBD6E0",
          "$type": "color",
          "$description": "柔蓝 · 辅助"
        }
      },
      "warn": {
        "orange": {
          "400": {
            "$value": "#D48A3C",
            "$type": "color",
            "$description": "琥珀橙 · 警示"
          }
        }
      },
      "danger": {
        "red": {
          "500": {
            "$value": "#B93232",
            "$type": "color",
            "$description": "赤红 · 危机红"
          }
        }
      },
      "ink": {
        "gray": {
          "900": {
            "$value": "#2C2C2C",
            "$type": "color",
            "$description": "墨水灰 · 正文本"
          }
        }
      }
    },
    "spacing": {
      "0": { "$value": "0px", "$type": "dimension", "$description": "spacing 0" },
      "1": { "$value": "4px", "$type": "dimension", "$description": "spacing 1" },
      "2": { "$value": "8px", "$type": "dimension", "$description": "spacing 2" },
      "3": { "$value": "12px", "$type": "dimension", "$description": "spacing 3" },
      "4": { "$value": "16px", "$type": "dimension", "$description": "spacing 4" },
      "5": { "$value": "20px", "$type": "dimension", "$description": "spacing 5" },
      "6": { "$value": "24px", "$type": "dimension", "$description": "spacing 6" },
      "8": { "$value": "32px", "$type": "dimension", "$description": "spacing 8" }
    },
    "radius": {
      "sm": { "$value": "6px", "$type": "dimension", "$description": "圆角小" },
      "md": { "$value": "12px", "$type": "dimension", "$description": "圆角色" },
      "lg": { "$value": "20px", "$type": "dimension", "$description": "圆角大" }
    },
    "button": {
      "primary": {
        "background": { "$value": "{color.green.600}", "$type": "color" },
        "backgroundHover": { "$value": "#366C54", "$type": "color", "$description": "较主色深约 5%" },
        "text": { "$value": "#FFFFFF", "$type": "color" }
      },
      "secondary": {
        "background": { "$value": "transparent", "$type": "color" },
        "border": { "$value": "1px solid {color.green.600}", "$type": "color" },
        "text": { "$value": "{color.green.800}", "$type": "color" }
      },
      "disabled": {
        "opacity": { "$value": 0.4, "$type": "number" }
      }
    }
  }
}
